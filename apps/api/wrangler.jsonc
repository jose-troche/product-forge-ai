{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "product-forge-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "product-forge-ai",
      "database_id": "dfc61dfe-e6e8-4daf-8502-ae6e0ffd9f4e",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "34f0e963aa784e369d500709f29ef8c2"
    }
  ],
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "APP_ENV": "production"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
